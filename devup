#!/usr/bin/env bash
#
# devup — one command to set up an Ubuntu machine for polyglot development.
#
#   https://github.com/YOUR-USERNAME/devup
#
# Idempotent: detects what is already installed and only does the missing work.

set -uo pipefail

DEVUP_VERSION="0.1.0"

# ---------- locate the project root (works through symlinks) ----------
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
DEVUP_ROOT="$(cd -P "$(dirname "$_self")" && pwd)"
export DEVUP_ROOT

# ---------- defaults ----------
DRY_RUN=0
VERBOSE=0
ASSUME_YES=0
NO_TUI=0
MODE=""            # auto | manual
PROFILE=""
ONLY=""
SUBCMD=""
declare -a POSITIONAL=()

# ---------- load libraries ----------
for _lib in core registry install ui; do
  # shellcheck disable=SC1090
  . "$DEVUP_ROOT/lib/${_lib}.sh" || { echo "devup: failed to load lib/${_lib}.sh" >&2; exit 1; }
done

usage() {
  cat <<EOF
${C_BOLD}devup${C_RESET} v${DEVUP_VERSION} — Ubuntu developer machine setup

${C_BOLD}USAGE${C_RESET}
  devup                          Interactive menu (recommended)
  devup install [ID...]          Install specific packages
  devup config <ID>              Re-run only the configuration step
  devup list                     List every package and its status
  devup status                   Summary of what is installed
  devup doctor                   Diagnose common setup problems
  devup clean                    Reclaim disk from build caches
  devup profiles                 List available profiles

${C_BOLD}OPTIONS${C_RESET}
  -p, --profile NAME    Use a profile from profiles/ (e.g. fullstack)
  -a, --auto            Non-interactive: install without prompting
  -m, --manual          Print install instructions instead of running them
  -n, --dry-run         Show what would happen, change nothing
  -y, --yes             Assume yes for all confirmations
      --only IDS        Comma-separated package ids
      --no-tui          Plain text menus instead of whiptail
  -v, --verbose         Stream command output
  -h, --help            This help
      --version         Print version

${C_BOLD}EXAMPLES${C_RESET}
  devup                                    # menu-driven setup
  devup --profile fullstack --auto --yes   # unattended full setup
  devup --dry-run --profile minimal        # preview a minimal setup
  devup install ripgrep fzf lazygit        # just these three
  devup config shell-integration           # regenerate shell config
  devup list                               # audit the machine

Logs are written to ~/.local/state/devup/devup.log
EOF
}

# ---------- argument parsing ----------
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      install|config|list|status|doctor|clean|profiles)
        [[ -z "$SUBCMD" ]] && SUBCMD="$1" || POSITIONAL+=("$1"); shift ;;
      -p|--profile) PROFILE="${2:-}"; shift 2 ;;
      -a|--auto)    MODE="auto"; shift ;;
      -m|--manual)  MODE="manual"; shift ;;
      -n|--dry-run) DRY_RUN=1; shift ;;
      -y|--yes)     ASSUME_YES=1; shift ;;
      --only)       ONLY="${2:-}"; shift 2 ;;
      --no-tui)     NO_TUI=1; shift ;;
      -v|--verbose) VERBOSE=1; shift ;;
      -h|--help)    usage; exit 0 ;;
      --version)    printf 'devup %s\n' "$DEVUP_VERSION"; exit 0 ;;
      -*)           echo "devup: unknown option '$1'" >&2; usage; exit 2 ;;
      *)            POSITIONAL+=("$1"); shift ;;
    esac
  done
  export DRY_RUN VERBOSE ASSUME_YES NO_TUI
}

# ---------- banner ----------
banner() {
  printf '%s\n' "${C_CYAN}${C_BOLD}"
  cat <<'ART'
   __
  |  \  _  _   _  ._
  |__/ (/ \/ /_/ |_)
           /       |
ART
  printf '%s' "${C_RESET}"
  printf '%s\n\n' "  ${C_DIM}developer machine setup · v${DEVUP_VERSION}${C_RESET}"
}

# ---------- reporting ----------
cmd_list() {
  local g id count_i=0 count_m=0
  for g in "${GROUP_IDS[@]}"; do
    printf '\n%s\n' "${C_BOLD}${GROUP_TITLE[$g]}${C_RESET} ${C_DIM}(${g})${C_RESET}"
    while read -r id; do
      [[ -z "$id" ]] && continue
      case "${PKG_STATUS[$id]}" in
        installed) printf '  %s✓%s %-18s %s\n' "$C_GREEN" "$C_RESET" "$id" "${C_DIM}${PKG_DESC[$id]}${C_RESET}"; ((count_i++)) ;;
        missing)   printf '  %s·%s %-18s %s\n' "$C_YELLOW" "$C_RESET" "$id" "${C_DIM}${PKG_DESC[$id]}${C_RESET}"; ((count_m++)) ;;
        *)         printf '  %s?%s %-18s %s\n' "$C_DIM" "$C_RESET" "$id" "${C_DIM}${PKG_DESC[$id]}${C_RESET}" ;;
      esac
    done < <(pkgs_in_group "$g")
  done
  printf '\n%s%d installed%s · %s%d available%s · %d total\n' \
    "$C_GREEN" "$count_i" "$C_RESET" "$C_YELLOW" "$count_m" "$C_RESET" "${#PKG_IDS[@]}"
}

cmd_status() {
  local g id total=0 have=0
  printf '\n%s\n' "${C_BOLD}Machine status${C_RESET}"
  printf '  %-14s %s\n' "OS" "${PRETTY_NAME:-$OS_ID $OS_VERSION} (${OS_CODENAME})"
  printf '  %-14s %s\n' "Kernel" "$(uname -r)"
  printf '  %-14s %s\n' "Arch" "$(uname -m) → deb:${DEB_ARCH}"
  printf '  %-14s %s\n' "CPU" "$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ *//' || echo unknown)"
  printf '  %-14s %s cores\n' "Cores" "$(nproc 2>/dev/null || echo '?')"
  printf '  %-14s %s\n' "Memory" "$(free -h 2>/dev/null | awk '/^Mem:/{print $2" total, "$7" available"}')"
  printf '  %-14s %s\n' "Shell" "$(getent passwd "$USER" | cut -d: -f7)"
  printf '  %-14s %s\n' "Session" "${XDG_SESSION_TYPE:-unknown}"
  printf '  %-14s %s\n' "Disk /" "$(df -h / | awk 'NR==2{print $3" used of "$2" ("$5"), "$4" free"}')"

  printf '\n%s\n' "${C_BOLD}Coverage by group${C_RESET}"
  for g in "${GROUP_IDS[@]}"; do
    total=0; have=0
    while read -r id; do
      [[ -z "$id" ]] && continue
      ((total++))
      [[ "${PKG_STATUS[$id]}" == "installed" ]] && ((have++))
    done < <(pkgs_in_group "$g")
    local bar="" i filled=$(( total > 0 ? have * 20 / total : 0 ))
    for ((i=0; i<20; i++)); do
      if (( i < filled )); then bar+="█"; else bar+="░"; fi
    done
    printf '  %-22s %s %2d/%-2d\n' "${GROUP_TITLE[$g]}" "$bar" "$have" "$total"
  done
  printf '\n%sRun `devup` to install what is missing, or `devup list` for detail.%s\n' "$C_DIM" "$C_RESET"
}

cmd_doctor() {
  local issues=0
  printf '\n%s\n\n' "${C_BOLD}devup doctor${C_RESET}"

  _check() {
    local ok="$1" label="$2" fix="$3"
    if [[ "$ok" == "0" ]]; then
      printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$label"
    else
      printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$label"
      printf '      %s→ %s%s\n' "$C_DIM" "$fix" "$C_RESET"
      ((issues++))
    fi
  }

  # PATH
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) _check 0 "~/.local/bin is on PATH" "" ;;
    *) _check 1 "~/.local/bin is NOT on PATH" "Open a new shell, or: source ~/.config/devup/shell.sh" ;;
  esac

  # shell wiring
  if [[ -f "$HOME/.config/devup/shell.sh" ]]; then
    _check 0 "shell integration file exists" ""
    if grep -q "devup:shell" "$HOME/.zshrc" 2>/dev/null || grep -q "devup:shell" "$HOME/.bashrc" 2>/dev/null; then
      _check 0 "shell integration is sourced from an rc file" ""
    else
      _check 1 "shell integration is not sourced" "devup config shell-integration"
    fi
  else
    _check 1 "shell integration not generated" "devup config shell-integration"
  fi

  # login shell
  if [[ "$(getent passwd "$USER" | cut -d: -f7)" == *zsh ]]; then
    _check 0 "login shell is zsh" ""
  else
    _check 1 "login shell is not zsh" "sudo chsh -s \$(which zsh) $USER, then log out and back in"
  fi

  # docker group
  if command -v docker >/dev/null 2>&1; then
    if id -nG "$USER" | tr ' ' '\n' | grep -qx docker; then
      if docker info >/dev/null 2>&1; then
        _check 0 "docker works without sudo" ""
      else
        _check 1 "in the docker group but the daemon is unreachable" "Log out and back in, or: newgrp docker"
      fi
    else
      _check 1 "$USER is not in the docker group" "sudo usermod -aG docker $USER, then log out and back in"
    fi
    if [[ -f /etc/docker/daemon.json ]] && grep -q max-size /etc/docker/daemon.json 2>/dev/null; then
      _check 0 "docker log rotation configured" ""
    else
      _check 1 "docker logs are unrotated (can silently eat tens of GB)" "devup config docker"
    fi
  fi

  # cargo shared target
  if command -v cargo >/dev/null 2>&1; then
    if grep -q 'target-dir' "$HOME/.cargo/config.toml" 2>/dev/null; then
      _check 0 "cargo uses a shared target directory" ""
    else
      _check 1 "each Rust project keeps its own target/ (3-5GB each)" "devup config rust"
    fi
  fi

  # nerd font
  if command -v fc-list >/dev/null 2>&1; then
    if fc-list 2>/dev/null | grep -qi "nerd font"; then
      _check 0 "a Nerd Font is installed" ""
    else
      _check 1 "no Nerd Font found (prompt glyphs will render as boxes)" "devup install nerd-font"
    fi
  fi

  # snaps we don't want
  if command -v snap >/dev/null 2>&1; then
    local bad
    bad="$(snap list 2>/dev/null | awk 'NR>1 && ($1=="docker") {print $1}' | tr '\n' ' ')"
    if [[ -n "${bad// /}" ]]; then
      _check 1 "docker is installed as a snap (confinement breaks bind mounts)" "sudo snap remove docker && devup install docker"
    else
      _check 0 "no problematic snaps detected" ""
    fi
  fi

  # git identity
  if command -v git >/dev/null 2>&1; then
    if [[ -n "$(git config --global --get user.email 2>/dev/null || true)" ]]; then
      _check 0 "git user.email is set" ""
    else
      _check 1 "git user.email is unset" "git config --global user.email you@example.com"
    fi
  fi

  # disk headroom
  local pct
  pct="$(df --output=pcent / | tail -1 | tr -dc '0-9')"
  if (( pct < 85 )); then
    _check 0 "disk usage is ${pct}%" ""
  else
    _check 1 "disk usage is ${pct}% — getting tight" "devup clean"
  fi

  printf '\n'
  if (( issues == 0 )); then
    success "No problems found."
  else
    warn "$issues issue(s) found. Suggested fixes are shown above."
  fi
}

cmd_profiles() {
  printf '\n%s\n\n' "${C_BOLD}Available profiles${C_RESET}"
  local f name n
  shopt -s nullglob
  for f in "$DEVUP_ROOT"/profiles/*.conf; do
    name="$(basename "$f" .conf)"
    n="$(grep -cvE '^\s*(#|$)' "$f" 2>/dev/null || echo 0)"
    printf '  %s%-12s%s %s\n' "$C_BOLD" "$name" "$C_RESET" "${C_DIM}${n} packages${C_RESET}"
    grep -m1 '^# desc:' "$f" 2>/dev/null | sed 's/^# desc: */      /' || true
  done
  shopt -u nullglob
  printf '\n%sUse with: devup --profile <name> --auto%s\n' "$C_DIM" "$C_RESET"
}

# ---------- profile loading ----------
load_profile() {
  local name="$1" f="$DEVUP_ROOT/profiles/${1}.conf"
  [[ -f "$f" ]] || die "No such profile: $name (try: devup profiles)"
  grep -vE '^\s*(#|$)' "$f" | tr -d ' \t'
}

default_selection() {
  local id
  for id in "${PKG_IDS[@]}"; do
    [[ "${PKG_DEFAULT[$id]}" == "yes" ]] && printf '%s\n' "$id"
  done
}

# ---------- the install engine ----------
declare -a RESULT_OK=() RESULT_SKIP=() RESULT_FAIL=() COLLECTED_NOTES=()

# run_selection <id...>
run_selection() {
  local -a sel=()
  mapfile -t sel < <(resolve_deps "$@")
  (( ${#sel[@]} > 0 )) || { warn "Nothing selected."; return 0; }

  # Split into work to do vs already satisfied.
  local -a todo=() already=()
  local id
  for id in "${sel[@]}"; do
    if [[ "${PKG_STATUS[$id]}" == "installed" ]]; then
      already+=("$id")
    else
      todo+=("$id")
    fi
  done

  # ---- show the plan ----
  step "Plan"
  if (( ${#already[@]} > 0 )); then
    printf '  %sAlready installed (config will be re-applied):%s\n' "$C_DIM" "$C_RESET"
    printf '    %s\n' "$(human_join "${already[@]}")"
  fi
  if (( ${#todo[@]} > 0 )); then
    printf '  %sTo install (%d):%s\n' "$C_BOLD" "${#todo[@]}" "$C_RESET"
    for id in "${todo[@]}"; do
      printf '    %s+%s %-16s %s\n' "$C_GREEN" "$C_RESET" "${PKG_NAME[$id]}" "${C_DIM}${PKG_DESC[$id]}${C_RESET}"
    done
  else
    success "Everything selected is already installed."
  fi

  if (( DRY_RUN )); then
    info "Dry run — no changes will be made."
  fi

  if (( ${#todo[@]} > 0 )) || (( ${#already[@]} > 0 )); then
    if ! confirm "Proceed?"; then
      info "Cancelled."
      return 0
    fi
  fi

  # ---- sudo only if we actually have work ----
  if (( ${#todo[@]} > 0 )); then
    setup_sudo
  fi

  ensure_local_bin

  # ---- execute ----
  local total="${#sel[@]}" n=0
  for id in "${sel[@]}"; do
    ((n++))
    ui_status_line "$n" "$total" "${PKG_NAME[$id]}"

    # install (skip if present)
    if [[ "${PKG_STATUS[$id]}" == "installed" ]]; then
      printf '  %salready installed%s\n' "$C_DIM" "$C_RESET"
      RESULT_SKIP+=("$id")
    else
      if [[ -n "${PKG_INSTALL[$id]}" ]]; then
        if eval "${PKG_INSTALL[$id]}"; then
          success "${PKG_NAME[$id]} installed"
          RESULT_OK+=("$id")
          PKG_STATUS["$id"]="installed"
        else
          error "${PKG_NAME[$id]} failed — continuing with the rest"
          RESULT_FAIL+=("$id")
          continue
        fi
      else
        RESULT_SKIP+=("$id")
      fi
    fi

    # config (always attempt, so it is re-runnable)
    if [[ -n "${PKG_CONFIG[$id]}" ]]; then
      if ! eval "${PKG_CONFIG[$id]}"; then
        warn "${PKG_NAME[$id]}: configuration step reported a problem"
      fi
    fi

    [[ -n "${PKG_NOTE[$id]}" ]] && COLLECTED_NOTES+=("${PKG_NAME[$id]}: ${PKG_NOTE[$id]}")
  done

  print_summary
}

print_summary() {
  step "Summary"
  (( ${#RESULT_OK[@]} > 0 ))   && printf '  %s✓ installed:%s %s\n' "$C_GREEN" "$C_RESET" "$(human_join "${RESULT_OK[@]}")"
  (( ${#RESULT_SKIP[@]} > 0 )) && printf '  %s· unchanged:%s %s\n' "$C_DIM" "$C_RESET" "$(human_join "${RESULT_SKIP[@]}")"
  (( ${#RESULT_FAIL[@]} > 0 )) && printf '  %s✗ failed:%s %s\n' "$C_RED" "$C_RESET" "$(human_join "${RESULT_FAIL[@]}")"

  if (( ${#COLLECTED_NOTES[@]} > 0 )); then
    printf '\n%s\n' "${C_BOLD}Next steps${C_RESET}"
    local note
    for note in "${COLLECTED_NOTES[@]}"; do
      printf '  %s•%s %s\n' "$C_YELLOW" "$C_RESET" "$note"
    done
  fi

  if (( ${#RESULT_FAIL[@]} > 0 )); then
    printf '\n%sSee the log for details: %s%s\n' "$C_DIM" "$LOG_FILE" "$C_RESET"
  fi

  printf '\n%s\n' "${C_BOLD}Then:${C_RESET}"
  printf '  1. Open a new terminal (or: exec zsh) to pick up the new PATH and tools\n'
  printf '  2. Run %sdevup doctor%s to verify everything is wired up\n' "$C_BOLD" "$C_RESET"
  printf '  3. Set your WezTerm font to "JetBrainsMono Nerd Font" if it did not apply\n'
}

# ---------- manual instructions mode ----------
print_manual() {
  local -a sel=()
  mapfile -t sel < <(resolve_deps "$@")
  step "Manual installation instructions"
  printf '%sNothing below has been executed. Copy what you want.%s\n' "$C_DIM" "$C_RESET"
  local g id shown
  for g in "${GROUP_IDS[@]}"; do
    shown=0
    for id in "${sel[@]}"; do
      [[ "${PKG_GROUP[$id]}" == "$g" ]] || continue
      if (( ! shown )); then
        printf '\n%s# %s%s\n' "$C_BOLD" "${GROUP_TITLE[$g]}" "$C_RESET"
        shown=1
      fi
      printf '\n  %s%s%s' "$C_CYAN" "${PKG_NAME[$id]}" "$C_RESET"
      [[ "${PKG_STATUS[$id]}" == "installed" ]] && printf ' %s(already installed)%s' "$C_GREEN" "$C_RESET"
      printf '\n    %s%s%s\n' "$C_DIM" "${PKG_DESC[$id]}" "$C_RESET"
      if [[ -n "${PKG_MANUAL[$id]}" ]]; then
        printf '    $ %s\n' "${PKG_MANUAL[$id]}"
      else
        printf '    $ %s\n' "${PKG_INSTALL[$id]}"
      fi
      [[ -n "${PKG_NOTE[$id]}" ]] && printf '    %s! %s%s\n' "$C_YELLOW" "${PKG_NOTE[$id]}" "$C_RESET"
    done
  done
  printf '\n%sTo let devup do all of this for you: devup --auto%s\n\n' "$C_DIM" "$C_RESET"
}

# ---------- interactive menus ----------
menu_custom_select() {
  # Step 1: choose groups.
  local -a gargs=()
  local g total have
  for g in "${GROUP_IDS[@]}"; do
    total=0; have=0
    while read -r id; do
      [[ -z "$id" ]] && continue
      ((total++)); [[ "${PKG_STATUS[$id]}" == "installed" ]] && ((have++))
    done < <(pkgs_in_group "$g")
    gargs+=("$g" "$(printf '%-24s %s' "${GROUP_TITLE[$g]}" "[${have}/${total} installed]")" "on")
  done

  local -a groups=()
  mapfile -t groups < <(ui_checklist "Categories" \
    "Choose the categories you want to work through:" "${gargs[@]}") || return 1
  (( ${#groups[@]} > 0 )) || { warn "No categories chosen."; return 1; }

  # Step 2: choose packages within each group.
  local -a chosen=() pargs=() picked=()
  local id state
  for g in "${groups[@]}"; do
    [[ -z "$g" ]] && continue
    pargs=()
    while read -r id; do
      [[ -z "$id" ]] && continue
      # Pre-tick recommended items that are not yet installed.
      if [[ "${PKG_STATUS[$id]}" == "installed" ]]; then
        state="off"
      elif [[ "${PKG_DEFAULT[$id]}" == "yes" ]]; then
        state="on"
      else
        state="off"
      fi
      pargs+=("$id" "$(pkg_label "$id")" "$state")
    done < <(pkgs_in_group "$g")
    (( ${#pargs[@]} > 0 )) || continue

    picked=()
    mapfile -t picked < <(ui_checklist "${GROUP_TITLE[$g]}" \
      "${GROUP_DESC[$g]}

[✓] = already installed (tick to re-apply its config)" \
      "${pargs[@]}") || continue
    for id in "${picked[@]}"; do
      [[ -n "$id" ]] && chosen+=("$id")
    done
  done

  (( ${#chosen[@]} > 0 )) || { warn "Nothing selected."; return 1; }
  printf '%s\n' "${chosen[@]}"
}

main_menu() {
  local choice
  while true; do
    choice="$(ui_menu "devup v${DEVUP_VERSION}" \
      "$(printf 'Ubuntu %s · %s installed of %s known packages\n\nWhat would you like to do?' \
          "$OS_VERSION" "$(count_installed)" "${#PKG_IDS[@]}")" \
      quick   "Quick setup — install the recommended fullstack set" \
      custom  "Custom setup — choose categories and packages" \
      status  "Show machine status and coverage" \
      list    "List every package with its status" \
      manual  "Print manual instructions (installs nothing)" \
      doctor  "Diagnose problems with the current setup" \
      clean   "Reclaim disk space from build caches" \
      quit    "Quit")" || return 0

    case "$choice" in
      quick)
        local -a sel=()
        mapfile -t sel < <(load_profile fullstack)
        run_selection "${sel[@]}"
        return 0 ;;
      custom)
        local -a sel=()
        mapfile -t sel < <(menu_custom_select) || continue
        (( ${#sel[@]} > 0 )) || continue
        run_selection "${sel[@]}"
        return 0 ;;
      manual)
        local -a sel=()
        mapfile -t sel < <(menu_custom_select) || continue
        (( ${#sel[@]} > 0 )) || continue
        print_manual "${sel[@]}"
        return 0 ;;
      status) cmd_status; press_enter ;;
      list)   cmd_list;   press_enter ;;
      doctor) cmd_doctor; press_enter ;;
      clean)  cmd_clean;  press_enter ;;
      quit|"") info "Nothing to do."; return 0 ;;
    esac
  done
}

press_enter() {
  (( USE_TUI )) || return 0
  printf '\n'
  read -r -p "Press Enter to return to the menu… " _ || true
}

count_installed() {
  local id n=0
  for id in "${PKG_IDS[@]}"; do
    [[ "${PKG_STATUS[$id]}" == "installed" ]] && ((n++))
  done
  printf '%d' "$n"
}

cmd_clean() {
  if [[ -x "$HOME/.local/bin/devup-clean" ]]; then
    "$HOME/.local/bin/devup-clean" $( ((DRY_RUN)) && printf '%s' '--dry-run' ) \
      $( ((ASSUME_YES)) && printf '%s' '--yes' )
  elif [[ -x "$DEVUP_ROOT/configs/devup-clean" ]]; then
    bash "$DEVUP_ROOT/configs/devup-clean" $( ((DRY_RUN)) && printf '%s' '--dry-run' ) \
      $( ((ASSUME_YES)) && printf '%s' '--yes' )
  else
    die "Cleanup script not found. Run: devup install devup-clean"
  fi
}

cmd_config() {
  local id="$1"
  pkg_exists "$id" || die "Unknown package: $id (try: devup list)"
  [[ -n "${PKG_CONFIG[$id]}" ]] || die "'$id' has no configuration step."
  setup_sudo
  ensure_local_bin
  step "Configuring ${PKG_NAME[$id]}"
  if eval "${PKG_CONFIG[$id]}"; then
    success "Done."
    [[ -n "${PKG_NOTE[$id]}" ]] && info "${PKG_NOTE[$id]}"
  else
    die "Configuration failed. See $LOG_FILE"
  fi
}

# ---------- entry ----------
main() {
  parse_args "$@"

  # logging
  local log_dir="$HOME/.local/state/devup"
  mkdir -p "$log_dir" 2>/dev/null || true
  LOG_FILE="$log_dir/devup.log"
  export LOG_FILE
  _log_raw "=== devup $DEVUP_VERSION invoked: $* ==="

  detect_os
  detect_arch
  make_tmp
  trap 'cleanup_tmp; cleanup_sudo' EXIT INT TERM

  load_modules
  ui_init

  info "Scanning the system…"
  detect_all

  # Build a selection from flags, if any were given.
  local -a sel=()
  if [[ -n "$ONLY" ]]; then
    IFS=',' read -r -a sel <<<"$ONLY"
  elif [[ -n "$PROFILE" ]]; then
    mapfile -t sel < <(load_profile "$PROFILE")
  fi

  case "$SUBCMD" in
    list)     cmd_list; exit 0 ;;
    status)   cmd_status; exit 0 ;;
    doctor)   cmd_doctor; exit 0 ;;
    profiles) cmd_profiles; exit 0 ;;
    clean)    cmd_clean; exit 0 ;;
    config)
      (( ${#POSITIONAL[@]} > 0 )) || die "Usage: devup config <package-id>"
      cmd_config "${POSITIONAL[0]}"; exit 0 ;;
    install)
      if (( ${#POSITIONAL[@]} > 0 )); then
        sel=("${POSITIONAL[@]}")
      elif (( ${#sel[@]} == 0 )); then
        die "Usage: devup install <id...>  (or use --profile / --only)"
      fi
      banner
      if [[ "$MODE" == "manual" ]]; then print_manual "${sel[@]}"; else run_selection "${sel[@]}"; fi
      exit 0 ;;
  esac

  banner

  # No subcommand.
  if [[ "$MODE" == "manual" ]]; then
    (( ${#sel[@]} > 0 )) || mapfile -t sel < <(default_selection)
    print_manual "${sel[@]}"
    exit 0
  fi

  if [[ "$MODE" == "auto" ]]; then
    (( ${#sel[@]} > 0 )) || mapfile -t sel < <(default_selection)
    run_selection "${sel[@]}"
    exit 0
  fi

  if (( ${#sel[@]} > 0 )); then
    run_selection "${sel[@]}"
    exit 0
  fi

  main_menu
}

main "$@"
