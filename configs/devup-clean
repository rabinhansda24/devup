#!/usr/bin/env bash
# devup-clean — reclaim disk from language and container caches.
#
# Usage:
#   devup-clean            # clean everything (prompts before Docker)
#   devup-clean --dry-run  # show sizes only, delete nothing
#   devup-clean --yes      # no prompts, for cron/systemd
#
# Installed by devup. Safe to run monthly.

set -uo pipefail

DRY=0
YES=0
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) DRY=1 ;;
    -y|--yes)     YES=1 ;;
    -h|--help)    sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done

if [[ -t 1 ]]; then
  B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; D=$'\033[2m'; R=$'\033[0m'
else
  B=""; G=""; Y=""; D=""; R=""
fi

before_avail() { df --output=avail -k / | tail -1 | tr -d ' '; }
START_AVAIL="$(before_avail)"

size_of() {
  [[ -e "$1" ]] || { echo "0B"; return; }
  du -sh "$1" 2>/dev/null | cut -f1
}

section() { printf '\n%s==>%s %s%s%s\n' "$G" "$R" "$B" "$1" "$R"; }
note()    { printf '  %s\n' "$1"; }
skip()    { printf '  %s(skipped: %s)%s\n' "$D" "$1" "$R"; }

do_run() {
  if (( DRY )); then
    printf '  %s[dry-run] %s%s\n' "$D" "$1" "$R"
  else
    bash -c "$1" >/dev/null 2>&1 || printf '  %s! failed: %s%s\n' "$Y" "$1" "$R"
  fi
}

confirm() {
  (( YES )) && return 0
  (( DRY )) && return 0
  local reply
  read -r -p "  $1 [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]]
}

printf '%sdevup-clean%s%s\n' "$B" "$R" "$( ((DRY)) && echo "  (dry run)" )"

# ---------------------------------------------------------------- Rust --------
section "Rust"
CARGO_TARGET="${CARGO_TARGET_DIR:-$HOME/.cache/cargo-target}"
if [[ -d "$CARGO_TARGET" ]]; then
  note "shared target dir: $(size_of "$CARGO_TARGET")"
  if command -v cargo-sweep >/dev/null 2>&1; then
    do_run "cargo sweep --time 30 --recursive '$CARGO_TARGET'"
  else
    note "${D}install cargo-sweep for age-based pruning: cargo install cargo-sweep${R}"
    if confirm "Delete build artifacts older than 30 days?"; then
      do_run "find '$CARGO_TARGET' -type f -atime +30 -delete"
      do_run "find '$CARGO_TARGET' -type d -empty -delete"
    fi
  fi
else
  skip "no shared cargo target dir"
fi

if [[ -d "$HOME/.cargo/registry" ]]; then
  note "registry cache: $(size_of "$HOME/.cargo/registry")"
  do_run "rm -rf '$HOME/.cargo/registry/src'"   # re-extracted on demand
fi

if command -v sccache >/dev/null 2>&1; then
  note "sccache: $(sccache --show-stats 2>/dev/null | grep -i 'cache size' || echo 'n/a')"
fi

# ------------------------------------------------------------------ Go --------
section "Go"
if command -v go >/dev/null 2>&1; then
  note "build cache: $(size_of "$(go env GOCACHE 2>/dev/null)")"
  note "module cache: $(size_of "$(go env GOMODCACHE 2>/dev/null)")"
  do_run "go clean -cache"
  if confirm "Also clear the Go module cache (will re-download on next build)?"; then
    do_run "go clean -modcache"
  fi
else
  skip "go not installed"
fi

# ---------------------------------------------------------------- Node --------
section "Node"
if command -v pnpm >/dev/null 2>&1; then
  note "pnpm store: $(size_of "$(pnpm store path 2>/dev/null)")"
  do_run "pnpm store prune"
else
  skip "pnpm not installed"
fi
[[ -d "$HOME/.npm/_cacache" ]] && {
  note "npm cache: $(size_of "$HOME/.npm/_cacache")"
  do_run "npm cache clean --force"
}
[[ -d "$HOME/.cache/yarn" ]] && {
  note "yarn cache: $(size_of "$HOME/.cache/yarn")"
  do_run "rm -rf '$HOME/.cache/yarn'"
}

# -------------------------------------------------------------- Python --------
section "Python"
if command -v uv >/dev/null 2>&1; then
  note "uv cache: $(size_of "$HOME/.cache/uv")"
  do_run "uv cache prune"
else
  skip "uv not installed"
fi
[[ -d "$HOME/.cache/pip" ]] && {
  note "pip cache: $(size_of "$HOME/.cache/pip")"
  do_run "rm -rf '$HOME/.cache/pip'"
}

# -------------------------------------------------------------- Docker --------
section "Docker"
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  docker system df 2>/dev/null | sed 's/^/  /'
  if confirm "Prune unused images, networks and build cache?"; then
    do_run "docker system prune -af"
    do_run "docker builder prune -af"
  fi
  if confirm "Also remove unused VOLUMES? (destroys database data in stopped containers)"; then
    do_run "docker volume prune -f"
  fi
else
  skip "docker not running or not installed"
fi

# -------------------------------------------------------------- System --------
section "System"
note "apt archives: $(size_of /var/cache/apt/archives)"
do_run "sudo apt-get autoremove -y -qq"
do_run "sudo apt-get clean"

if command -v journalctl >/dev/null 2>&1; then
  note "journal: $(journalctl --disk-usage 2>/dev/null | grep -o '[0-9.]*[KMG]' | head -1)"
  do_run "sudo journalctl --vacuum-time=14d"
fi

[[ -d "$HOME/.cache/thumbnails" ]] && do_run "rm -rf '$HOME/.cache/thumbnails'"

# ------------------------------------------------------------- Summary --------
END_AVAIL="$(before_avail)"
FREED=$(( (END_AVAIL - START_AVAIL) / 1024 ))
section "Done"
if (( DRY )); then
  note "Dry run — nothing was deleted."
else
  if (( FREED > 0 )); then
    printf '  %sReclaimed ~%s MB%s\n' "$G" "$FREED" "$R"
  else
    note "No significant space reclaimed."
  fi
fi
df -h / | sed 's/^/  /'

printf '\n  %sTip: run `dust -d 2 ~` or `ncdu ~` to find what is still large.%s\n' "$D" "$R"
